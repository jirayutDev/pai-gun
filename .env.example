# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง — ห้าม commit .env.local ขึ้น git
# (README หัวข้อ "ต่อ Neon Postgres" มีขั้นตอนไปเอาค่า DATABASE_URL จาก Neon)

# connection string จากหน้า Neon Console (เลือกอันที่มี ?sslmode=require)
DATABASE_URL=

# กันคนนอกยิง /api/cron/close มั่ว ๆ — สุ่มค่าเองด้วย เช่น:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ต้องตั้งค่าเดียวกันนี้ในตัวแปรแวดล้อมของ Vercel ด้วย (ดูขั้นตอน deploy ใน README)
CRON_SECRET=
